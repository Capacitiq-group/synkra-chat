<tr>
  <td>
    <p>Hi{% if contact.name %} {{ contact.name }}{% endif %},</p>
    <p>Thanks for reaching out. Please confirm your email address to start chatting - this helps us make sure we can always reach you, and lets you pick up the conversation from any device.</p>
  </td>
</tr>

<tr>
  <td align="center" style="padding: 24px 0;">
    <a
      href="{{ verification_url }}"
      style="background-color: #337418; color: #ffffff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-block;"
    >
      Verify email address
    </a>
  </td>
</tr>

<tr>
  <td>
    <p>This link will expire in 30 minutes. If you didn't request this, you can safely ignore this email.</p>
  </td>
</tr>

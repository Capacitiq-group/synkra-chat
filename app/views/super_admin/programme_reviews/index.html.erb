<% content_for(:title) do %>Programme reviews<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Programme reviews</h1>
</header>

<section class="main-content__body">
  <h2 class="text-base font-semibold mb-2">Waiting for review (<%= @waiting.size %>)</h2>
  <% if @waiting.empty? %>
    <p class="text-sm text-slate-600 mb-8">Nothing waiting.</p>
  <% else %>
    <table aria-labelledby="page-title" class="mb-8">
      <thead>
        <tr><th>Programme</th><th>Account</th><th>Route</th><th>Status</th><th>Submitted</th><th></th></tr>
      </thead>
      <tbody>
        <% @waiting.each do |v| %>
          <tr>
            <td><%= v.programme.titleize %></td>
            <td><%= v.account.name %> (ID <%= v.account_id %>)</td>
            <td><%= v.verification_method %></td>
            <td><%= v.status.humanize %></td>
            <td><%= v.submitted_at&.strftime('%-d %b %Y %H:%M') %></td>
            <td><%= link_to 'Review', super_admin_programme_review_path(v) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2 class="text-base font-semibold mb-2">Recent decisions</h2>
  <table>
    <thead>
      <tr><th>Programme</th><th>Account</th><th>Outcome</th><th>Decided</th><th>By</th><th></th></tr>
    </thead>
    <tbody>
      <% @recent.each do |v| %>
        <tr>
          <td><%= v.programme.titleize %></td>
          <td><%= v.account.name %> (ID <%= v.account_id %>)</td>
          <td><%= v.status.humanize %></td>
          <td><%= v.reviewed_at&.strftime('%-d %b %Y %H:%M') %></td>
          <td><%= v.reviewed_by %></td>
          <td><%= link_to 'View', super_admin_programme_review_path(v) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
